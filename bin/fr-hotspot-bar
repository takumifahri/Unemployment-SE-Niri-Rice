#!/bin/sh
# fr-hotspot-bar — modul waybar: ikon hotspot + jumlah perangkat. Kosong (tersembunyi) saat mati.
# Murah: cuma cek file /run; iw dipanggil hanya kalau hotspot menyala.
RUN=/run/fr-hotspot
[ -f "$RUN/hostapd.pid" ] && [ -e /sys/class/net/frap0 ] || exit 0
n=$(iw dev frap0 station dump 2>/dev/null | grep -c '^Station')
ssid=$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.config/fr-profile/hotspot.json")))["ssid"])' 2>/dev/null)
ssid=$(printf '%s' "${ssid:-Hotspot}" | sed 's/\\/\\\\/g; s/"/\\"/g; s/&/\&amp;/g; s/</\&lt;/g')
if [ "$n" -gt 0 ]; then cls=on; tip="$ssid · $n perangkat tersambung"; else cls=idle; tip="$ssid · menunggu perangkat"; fi
printf '{"text":"󰀂 %s","tooltip":"%s\\nklik: buka panel Wi-Fi","class":"%s"}\n' "$n" "$tip" "$cls"
