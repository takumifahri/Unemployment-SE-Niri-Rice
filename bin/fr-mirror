#!/usr/bin/env bash
# fr-mirror — layar laptop tampil sama persis di monitor eksternal (mode Mirror).
# niri belum punya mirror bawaan, jadi dipakai wl-mirror: jendela fullscreen di monitor eksternal
# yang menampilkan isi layar laptop. Prosesnya hanya hidup selama mirror menyala.
#
#   fr-mirror on [SUMBER] [TUJUAN]   default: sumber = layar laptop, tujuan = monitor eksternal pertama
#   fr-mirror off
#   fr-mirror status                 "on" / "off"
set -u
APPID=at.yrlf.wl_mirror
note() { command -v notify-send >/dev/null && notify-send -a Monitor -i video-display "$@"; }
fail() { echo "fr-mirror: $1" >&2; note "Mirror tidak bisa menyala" "$1"; exit 1; }

# daftar output niri: "nama<TAB>internal(1/0)"
outputs() {
    niri msg --json outputs 2>/dev/null | python3 -c '
import json, re, sys
for name in json.load(sys.stdin):
    print(name, 1 if re.match(r"^(eDP|LVDS|DSI)", name) else 0, sep="\t")'
}
mirror_window() {
    niri msg --json windows 2>/dev/null | python3 -c '
import json, sys
print(next((str(w["id"]) for w in json.load(sys.stdin) if w.get("app_id") == "'"$APPID"'"), ""))'
}

case "${1:-status}" in
on)
    command -v wl-mirror >/dev/null || fail "wl-mirror belum terpasang (sudo pacman -S wl-mirror)"
    list=$(outputs) || true
    src=${2:-$(printf '%s\n' "$list" | awk -F'\t' '$2 == 1 {print $1; exit}')}
    dst=${3:-$(printf '%s\n' "$list" | awk -F'\t' '$2 == 0 {print $1; exit}')}
    [ -n "$src" ] || fail "layar laptop tidak ditemukan"
    [ -n "$dst" ] || fail "monitor eksternal tidak terhubung"

    pkill -x wl-mirror 2>/dev/null
    niri msg output "$src" on >/dev/null
    niri msg output "$dst" on >/dev/null
    sleep 0.3                                   # tunggu output selesai menyala

    # jendela baru muncul di monitor yang sedang fokus: fokus ke tujuan dulu,
    # lalu window-rule (open-fullscreen) membuatnya fullscreen di sana
    niri msg action focus-monitor "$dst" >/dev/null
    setsid -f wl-mirror --fullscreen-output "$dst" "$src" >/dev/null 2>&1 < /dev/null
    for _ in $(seq 30); do                      # maks. 3 detik
        [ -n "$(mirror_window)" ] && break
        sleep 0.1
    done
    niri msg action focus-monitor "$src" >/dev/null   # kerja tetap di layar laptop
    [ -n "$(mirror_window)" ] || fail "jendela wl-mirror tidak muncul"
    ;;
off)
    pkill -x wl-mirror 2>/dev/null; true ;;
status)
    pgrep -x wl-mirror >/dev/null && echo on || echo off ;;
*)
    sed -n '2,9p' "$0"; exit 1 ;;
esac
