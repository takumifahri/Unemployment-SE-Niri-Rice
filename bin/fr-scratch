#!/usr/bin/env python3
"""fr-scratch — terminal scratchpad untuk niri.

Tekan sekali: terminal melayang muncul di workspace yang sedang kamu lihat.
Tekan lagi saat terminal itu fokus: disembunyikan ke workspace kosong paling
bawah (urutan workspace-mu tidak berubah, Mod+1..9 tetap sama).
Bicara langsung ke socket IPC niri dengan ID workspace, jadi tepat juga di dua monitor.
"""
import json, os, shutil, socket, subprocess, sys

APP_ID = "fr-scratch"


def niri(request):
    path = os.environ.get("NIRI_SOCKET")
    if not path:
        sys.exit("fr-scratch: NIRI_SOCKET tidak ada (jalankan dari dalam sesi niri)")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(path)
        s.sendall((json.dumps(request) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        data = b""
        while b"\n" not in data:          # balasan niri = satu baris JSON
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
    reply = json.loads(data.decode().splitlines()[0])
    if "Err" in reply:
        sys.exit(f"fr-scratch: niri menolak: {reply['Err']}")
    return reply["Ok"]


def action(name, **args):
    niri({"Action": {name: args}})


def spawn_terminal():
    term = os.environ.get("FR_SCRATCH_TERM") or next(
        (t for t in ("alacritty", "foot", "kitty", "ghostty") if shutil.which(t)), None)
    if not term:
        sys.exit("fr-scratch: terminal tidak ditemukan")
    # setiap terminal punya cara sendiri untuk mengatur app-id
    args = {"alacritty": ["--class", APP_ID], "foot": ["--app-id", APP_ID],
            "kitty": ["--class", APP_ID], "ghostty": [f"--class={APP_ID}"]}.get(term, [])
    subprocess.Popen([term, *args], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    workspaces = niri("Workspaces")["Workspaces"]
    windows = niri("Windows")["Windows"]
    here = next(w for w in workspaces if w["is_focused"])
    win = next((w for w in windows if w.get("app_id") == APP_ID), None)

    if win is None:
        spawn_terminal()
    elif win["workspace_id"] == here["id"]:
        if win["is_focused"]:
            # sembunyikan: workspace terakhir (paling bawah) di monitor yang sama
            same = [w for w in workspaces if w["output"] == here["output"]]
            target = max(same, key=lambda w: w["idx"])
            if target["id"] != here["id"]:
                action("MoveWindowToWorkspace", window_id=win["id"],
                       reference={"Id": target["id"]}, focus=False)
        else:
            action("FocusWindow", id=win["id"])
    else:
        # tarik ke workspace yang sedang dilihat
        action("MoveWindowToWorkspace", window_id=win["id"],
               reference={"Id": here["id"]}, focus=True)
        action("FocusWindow", id=win["id"])


if __name__ == "__main__":
    main()
