#!/bin/sh
# fr-sysmon-sample stream|slow|info — data mentah untuk widget fr-sysmon
#
# stream: satu proses yang hidup selama widget terbuka, mencetak satu sampel
#         per detik diakhiri "END". Semua baca file pakai builtin `read`,
#         jadi tidak ada fork selain `sleep` (versi lama: puluhan proses/detik).
case "$1" in
stream)
    # daftar sensor & file frekuensi cukup dicari sekali di awal
    nl='
'
    temps=""
    for h in /sys/class/hwmon/hwmon*; do
        [ -r "$h/name" ] || continue
        read -r chip < "$h/name"
        for t in "$h"/temp*_input; do
            [ -r "$t" ] || continue
            label=""
            [ -r "${t%_input}_label" ] && read -r label < "${t%_input}_label"
            temps="$temps$chip|$label|$t$nl"
        done
    done
    freqs=""
    for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
        [ -r "$f" ] && freqs="$freqs$f$nl"
    done

    while :; do
        while read -r name rest; do
            case $name in cpu*) echo "CPU $name $rest" ;; *) break ;; esac
        done < /proc/stat

        while read -r k v _; do
            case $k in
                MemTotal:) mt=$v ;; MemAvailable:) ma=$v ;;
                SwapTotal:) st=$v ;; SwapFree:) sf=$v ;;
            esac
        done < /proc/meminfo
        echo "MEM $mt $ma $st $sf"

        read -r l1 l5 l15 _ < /proc/loadavg
        echo "LOAD $l1 $l5 $l15"

        s=0; n=0
        IFS=$nl
        for f in $freqs; do
            read -r v < "$f" && { s=$((s + v)); n=$((n + 1)); }
        done
        for e in $temps; do
            chip=${e%%|*}; rest=${e#*|}; label=${rest%%|*}; file=${rest#*|}
            read -r v < "$file" && echo "TEMP $chip|$label|$v"
        done
        unset IFS
        [ "$n" -gt 0 ] && echo "FREQ $((s / n))"

        r=0; w=0
        while read -r _ _ dev _ _ rs _ _ _ ws _; do
            case $dev in
                nvme*n[0-9]|nvme*n[0-9][0-9]|sd[a-z]|vd[a-z]|mmcblk[0-9]) r=$((r + rs)); w=$((w + ws)) ;;
            esac
        done < /proc/diskstats
        echo "DISK $r $w"

        echo END
        sleep 1
    done
    ;;
slow)
    df -B1 --output=target,size,used -x tmpfs -x devtmpfs -x efivarfs -x overlay -x squashfs 2>/dev/null |
        awk 'NR>1 && $1 !~ /^\/(boot|run|snap)/ {print "FS " $1 "|" $2 "|" $3}'
    # CPU per proses = beban SAAT INI (selisih waktu CPU dalam 1 detik, seperti btop), bukan %cpu dari ps
    # yang merupakan rata-rata sejak proses lahir. Persen dari total CPU (semua thread = 100%).
    snap() {
        cat /proc/[0-9]*/stat 2>/dev/null | awk '{
            o = index($0, "("); c = 0
            for (i = length($0); i > o; i--) if (substr($0, i, 1) == ")") { c = i; break }
            split(substr($0, c + 2), f, " ")
            printf "%s\t%d\t%d\t%s\n", $1, f[12] + f[13], f[22], substr($0, o + 1, c - o - 1) }'
    }
    read -r up0 _ < /proc/uptime; A=$(snap)
    sleep 1
    read -r up1 _ < /proc/uptime; B=$(snap)
    memkb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    { printf '%s\n' "$A"; echo "--"; printf '%s\n' "$B"; } |
        awk -F'\t' -v me=$$ -v parent=$PPID -v up0="$up0" -v up1="$up1" -v ncpu="$(nproc)" \
            -v hz="$(getconf CLK_TCK)" -v page="$(getconf PAGESIZE)" -v memkb="$memkb" '
            $0 == "--" { second = 1; next }
            !second { t[$1] = $2; next }
            # lewati thread kernel (kworker dll., RSS 0) dan sampler monitor ini sendiri
            ($1 in t) && $1 != me && $1 != parent && $3 > 0 && $4 !~ /^fr-sysmon/ {
                dt = up1 - up0; if (dt <= 0) dt = 1
                cpu = ($2 - t[$1]) / hz / dt / ncpu * 100; if (cpu < 0) cpu = 0
                mem = $3 * page / 1024 / memkb * 100
                printf "%.3f\t%.3f\t%s\n", cpu, mem, $4 }' |
        sort -t "$(printf '\t')" -k1,1gr -k2,2gr | head -5 |
        awk -F'\t' '{ printf "PROC %s|%.1f|%.1f\n", $3, $1, $2 }'
    ;;
info)
    m=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//; s/ with .*//; s/ [0-9]*-Core Processor//')
    echo "MODEL $m"
    echo "THREADS $(nproc)"
    echo "HOST $(cat /proc/sys/kernel/hostname)"
    ;;
esac
